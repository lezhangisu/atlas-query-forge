      "id": "select_function",
      "domain": "General Function",
      "title": "Select Function",
      "description": "Select a function by name.",
      "natural_language_examples": [
        "Find function dskenq",
        "Select dskqopt",
        "Get the function getbuf"
      ],
      "confidence_keywords": ["function", "find", "select", "get"],
      "slots": {
        "functionName": {
          "type": "function",
          "required": true,
          "description": "Target function name"
        }
      },
      "allowed_tags": [],
      "allowed_methods": ["functions"],
      "output_type": "query",
      "template": "var ${functionVar} = functions(\"${functionName}\")"
    },
